{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ncheta-magazine",
  "compatibility_date": "2026-07-03",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "observability": {
    "enabled": true,
  },
  // Run `wrangler d1 create ncheta-store` and paste the returned database_id below
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ncheta-store",
      "database_id": "9676da7a-2c28-445b-a500-dd33e43ba0e5",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "BOOKS_BUCKET",
      "bucket_name": "ncheta-digital-books",
      "preview_bucket_name": "ncheta-digital-books-dev",
    },
  ],
}
