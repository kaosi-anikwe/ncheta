---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/navigation/Header.astro";
import Footer from "../../components/navigation/Footer.astro";
---

<Layout title="Your Cart" description="Review your cart before checkout.">
  <Header />

  <main class="flex-1">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <h1 class="font-cinzel text-3xl font-bold text-noir mb-8">Your Cart</h1>

      <!-- Loading state -->
      <div id="cart-loading" class="font-inter text-sm text-noir/40">Loading cart…</div>

      <!-- Empty state -->
      <div id="cart-empty" class="hidden text-center py-16">
        <p class="font-inter text-noir/50 text-base mb-6">Your cart is empty.</p>
        <a
          href="/store"
          class="inline-block h-10 px-6 bg-noir text-cotton font-inter text-sm font-medium
                 hover:bg-maroon transition-colors duration-200 leading-10"
        >
          Browse Books
        </a>
      </div>

      <!-- Cart items -->
      <div id="cart-content" class="hidden">
        <div id="cart-items" class="divide-y divide-noir/10 border-y border-noir/10 mb-8"></div>

        <!-- Summary -->
        <div class="max-w-xs ml-auto space-y-2">
          <div class="flex justify-between font-inter text-sm text-noir/60">
            <span>Subtotal</span>
            <span id="cart-subtotal"></span>
          </div>
          <p class="font-inter text-xs text-noir/40">Shipping and tax calculated at checkout.</p>
          <a
            href="/store/checkout"
            id="checkout-link"
            class="mt-4 flex items-center justify-center h-12 w-full bg-noir text-cotton
                   font-inter font-medium text-sm tracking-wide
                   border border-noir
                   hover:bg-maroon hover:border-maroon
                   focus:outline-none focus:ring-2 focus:ring-maroon/40 focus:ring-offset-2 focus:ring-offset-cotton
                   transition-colors duration-200"
          >
            Proceed to Checkout
          </a>
          <a
            href="/store"
            class="block text-center font-inter text-xs text-noir/50 hover:text-noir mt-2 transition-colors"
          >
            Continue shopping
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const CART_KEY = "ncheta_cart_v1";
  const CURRENCY_KEY = "ncheta_currency";

  interface CartItem {
    bookId: string;
    bookTitle: string;
    bookSlug: string;
    format: "pdf" | "epub" | "physical";
    formatKey: string;
    currency: "NGN" | "USD";
    unitPrice: number;
    quantity: number;
    coverUrl?: string;
  }

  function getCart(): CartItem[] {
    try { return JSON.parse(localStorage.getItem(CART_KEY) ?? "[]"); } catch { return []; }
  }

  function saveCart(cart: CartItem[]) {
    try { localStorage.setItem(CART_KEY, JSON.stringify(cart)); } catch {}
    window.dispatchEvent(new CustomEvent("cart:updated", { detail: cart }));
  }

  function formatPrice(amount: number, cur: "NGN" | "USD"): string {
    if (cur === "NGN") return "₦" + (amount / 100).toLocaleString("en-NG", { minimumFractionDigits: 0 });
    return "$" + (amount / 100).toFixed(2);
  }

  const formatLabels: Record<string, string> = {
    pdf: "Digital — PDF",
    epub: "Digital — EPUB",
    physical: "Physical Book",
  };

  function renderCart() {
    const cart = getCart();
    const loading = document.getElementById("cart-loading")!;
    const empty = document.getElementById("cart-empty")!;
    const content = document.getElementById("cart-content")!;
    const itemsEl = document.getElementById("cart-items")!;
    const subtotalEl = document.getElementById("cart-subtotal")!;

    loading.classList.add("hidden");

    if (cart.length === 0) {
      empty.classList.remove("hidden");
      content.classList.add("hidden");
      return;
    }

    empty.classList.add("hidden");
    content.classList.remove("hidden");

    itemsEl.innerHTML = "";
    let subtotal = 0;
    let subtotalCur: "NGN" | "USD" = "NGN";

    for (const item of cart) {
      subtotalCur = item.currency;
      subtotal += item.unitPrice * item.quantity;

      const row = document.createElement("div");
      row.className = "flex gap-4 py-5";
      row.innerHTML = `
        <div class="shrink-0 w-16 h-24 bg-noir/5 overflow-hidden">
          ${item.coverUrl
            ? `<img src="${item.coverUrl}" alt="${item.bookTitle}" class="w-full h-full object-cover" />`
            : `<div class="w-full h-full" style="background:linear-gradient(160deg,var(--color-maroon),var(--color-noir))"></div>`
          }
        </div>
        <div class="flex-1 min-w-0">
          <a href="/store/${item.bookSlug}" class="font-cinzel font-bold text-sm text-noir hover:text-maroon transition-colors">
            ${item.bookTitle}
          </a>
          <p class="mt-0.5 font-inter text-xs text-noir/50">${formatLabels[item.format] ?? item.format}</p>
          <div class="mt-3 flex items-center gap-3">
            <label class="sr-only" for="qty-${item.formatKey}">Quantity</label>
            <select
              id="qty-${item.formatKey}"
              data-format-key="${item.formatKey}"
              class="h-7 px-2 text-xs font-inter bg-cotton border border-noir/20 focus:outline-none focus:border-maroon"
            >
              ${[1,2,3,4,5].map(n => `<option ${n === item.quantity ? "selected" : ""}>${n}</option>`).join("")}
            </select>
            <button
              data-remove="${item.formatKey}"
              class="font-inter text-xs text-noir/40 hover:text-cherry transition-colors cursor-pointer"
            >Remove</button>
          </div>
        </div>
        <div class="shrink-0 font-inter text-sm font-semibold text-noir tabular-nums">
          ${formatPrice(item.unitPrice * item.quantity, item.currency)}
        </div>
      `;
      itemsEl.appendChild(row);
    }

    subtotalEl.textContent = formatPrice(subtotal, subtotalCur);

    // Quantity change
    itemsEl.querySelectorAll<HTMLSelectElement>("select[data-format-key]").forEach((sel) => {
      sel.addEventListener("change", () => {
        const key = sel.dataset.formatKey!;
        const cart = getCart();
        const idx = cart.findIndex((i) => i.formatKey === key);
        if (idx >= 0) {
          cart[idx].quantity = Number(sel.value);
          saveCart(cart);
          renderCart();
        }
      });
    });

    // Remove
    itemsEl.querySelectorAll<HTMLButtonElement>("button[data-remove]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const key = btn.dataset.remove!;
        saveCart(getCart().filter((i) => i.formatKey !== key));
        renderCart();
      });
    });
  }

  document.addEventListener("DOMContentLoaded", renderCart);
</script>
