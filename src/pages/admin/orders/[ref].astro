---
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";

const { ref } = Astro.params;
if (!ref) return Astro.redirect("/admin/orders", 301);

const env = Astro.locals.runtime.env;

type OrderRow = {
  id: string; reference: string; status: string; order_type: string;
  customer_name: string; customer_email: string; customer_phone: string | null;
  total_amount: number; subtotal: number; shipping_cost: number; tax_amount: number;
  currency: string; created_at: string; updated_at: string;
  ship_line1: string | null; ship_line2: string | null;
  ship_city: string | null; ship_state: string | null;
  ship_country: string | null; ship_postal: string | null;
  dhl_quote_json: string | null; tracking_number: string | null; dispatched_at: string | null;
};

type OrderItemRow = {
  id: string; book_title: string; book_slug: string;
  format: string; unit_price: number; quantity: number; r2_key: string | null;
};

const order = await env.DB.prepare(
  `SELECT id, reference, status, order_type, customer_name, customer_email, customer_phone,
          total_amount, subtotal, shipping_cost, tax_amount, currency, created_at, updated_at,
          ship_line1, ship_line2, ship_city, ship_state, ship_country, ship_postal,
          dhl_quote_json, tracking_number, dispatched_at
   FROM orders WHERE reference = ?`
).bind(ref).first<OrderRow>();

if (!order) return new Response(null, { status: 404 });

const items = await env.DB.prepare(
  "SELECT id, book_title, book_slug, format, unit_price, quantity, r2_key FROM order_items WHERE order_id = ?"
).bind(order.id).all<OrderItemRow>();

const dispatched = Astro.url.searchParams.has("dispatched");
const dispatchError = Astro.url.searchParams.has("dispatch_error");

function formatPrice(amount: number, cur: string): string {
  if (cur === "NGN") return "₦" + (amount / 100).toLocaleString("en-NG", { minimumFractionDigits: 0 });
  return "$" + (amount / 100).toFixed(2);
}

const formatLabels: Record<string, string> = {
  pdf: "Digital — PDF", epub: "Digital — EPUB", physical: "Physical Book",
};

const statusColors: Record<string, string> = {
  pending: "text-noir/50", paid: "text-lime", failed: "text-cherry",
  refunded: "text-noir/40", dispatched: "text-lime",
};
---

<Layout title={`Order ${order.reference} — Admin`} description="Ncheta admin order detail">
  <div class="min-h-screen bg-cotton">
    <header class="border-b border-noir/10 bg-cotton px-6 py-4 flex items-center gap-6">
      <span class="font-cinzel text-sm font-bold text-noir tracking-widest uppercase">Ncheta Admin</span>
      <nav class="flex items-center gap-4 font-inter text-sm">
        <a href="/admin/orders" class="text-noir/50 hover:text-noir transition-colors">← Orders</a>
        <a href="/admin/upload" class="text-noir/50 hover:text-noir transition-colors">Upload</a>
      </nav>
    </header>

    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-8 space-y-6">

      {dispatched && (
        <div class="p-4 border border-lime/30 bg-lime/10 font-inter text-sm text-noir">
          Order marked as dispatched. Customer notification email sent.
        </div>
      )}
      {dispatchError && (
        <div class="p-4 border border-cherry/20 bg-cherry/5 font-inter text-sm text-cherry">
          Failed to update dispatch status. Please try again.
        </div>
      )}

      <!-- Header -->
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="font-cinzel font-bold text-2xl text-noir">{order.reference}</h1>
          <p class:list={["mt-1 font-inter text-sm capitalize font-semibold", statusColors[order.status] ?? "text-noir/50"]}>
            {order.status}
          </p>
        </div>
        <p class="font-inter font-bold text-2xl text-noir tabular-nums">
          {formatPrice(order.total_amount, order.currency)}
        </p>
      </div>

      <!-- Customer -->
      <div class="border border-noir/10 p-5 space-y-2">
        <h2 class="font-cinzel font-bold text-sm text-noir uppercase tracking-wider mb-3">Customer</h2>
        <p class="font-inter text-sm text-noir">{order.customer_name}</p>
        <p class="font-inter text-sm text-noir/60">
          <a href={`mailto:${order.customer_email}`} class="hover:text-maroon">{order.customer_email}</a>
        </p>
        {order.customer_phone && <p class="font-inter text-sm text-noir/60">{order.customer_phone}</p>}
      </div>

      <!-- Items -->
      <div class="border border-noir/10 p-5">
        <h2 class="font-cinzel font-bold text-sm text-noir uppercase tracking-wider mb-3">Items</h2>
        <div class="divide-y divide-noir/8">
          {items.results.map((item) => (
            <div class="py-3 flex items-center justify-between gap-4 font-inter text-sm">
              <div>
                <span class="font-medium text-noir">{item.book_title}</span>
                <span class="ml-2 text-noir/40">{formatLabels[item.format] ?? item.format}</span>
                {item.quantity > 1 && <span class="ml-1 text-noir/40">×{item.quantity}</span>}
              </div>
              <span class="font-semibold text-noir tabular-nums">
                {formatPrice(item.unit_price * item.quantity, order.currency)}
              </span>
            </div>
          ))}
        </div>
        <div class="pt-3 mt-1 border-t border-noir/10 space-y-1 font-inter text-sm">
          {order.shipping_cost > 0 && (
            <div class="flex justify-between text-noir/60">
              <span>Shipping</span>
              <span>{formatPrice(order.shipping_cost, order.currency)}</span>
            </div>
          )}
          {order.tax_amount > 0 && (
            <div class="flex justify-between text-noir/60">
              <span>VAT (7.5%)</span>
              <span>{formatPrice(order.tax_amount, order.currency)}</span>
            </div>
          )}
          <div class="flex justify-between font-bold text-noir pt-1">
            <span>Total</span>
            <span>{formatPrice(order.total_amount, order.currency)}</span>
          </div>
        </div>
      </div>

      <!-- Shipping address -->
      {(order.order_type === "physical" || order.order_type === "mixed") && (
        <div class="border border-noir/10 p-5">
          <h2 class="font-cinzel font-bold text-sm text-noir uppercase tracking-wider mb-3">Shipping Address</h2>
          <address class="font-inter text-sm text-noir/70 not-italic space-y-0.5">
            {order.ship_line1 && <p>{order.ship_line1}</p>}
            {order.ship_line2 && <p>{order.ship_line2}</p>}
            {(order.ship_city || order.ship_state) && <p>{[order.ship_city, order.ship_state].filter(Boolean).join(", ")}</p>}
            {(order.ship_postal || order.ship_country) && <p>{[order.ship_postal, order.ship_country].filter(Boolean).join(" ")}</p>}
          </address>

          {order.dhl_quote_json && (() => {
            try {
              const q = JSON.parse(order.dhl_quote_json);
              return (
                <p class="mt-3 font-inter text-xs text-noir/50">
                  DHL: {q.serviceName} · ~{q.estimatedDaysWithBuffer} days · {q.currency} {(q.totalCharge / 100).toFixed(2)}
                </p>
              );
            } catch { return null; }
          })()}

          <!-- Dispatch form -->
          {order.status === "paid" && (
            <form
              method="POST"
              action={`/api/admin/orders/${order.reference}/dispatch`}
              class="mt-5 pt-5 border-t border-noir/10 space-y-3"
            >
              <h3 class="font-cinzel font-bold text-sm text-noir">Mark as Dispatched</h3>
              <div>
                <label for="tracking" class="block font-inter text-xs font-medium text-noir/50 uppercase tracking-wider mb-1.5">
                  Tracking Number (optional)
                </label>
                <input
                  id="tracking"
                  name="tracking_number"
                  type="text"
                  placeholder="e.g. 1234567890"
                  class="w-full h-10 px-3 border border-noir/20 bg-cotton font-inter text-sm text-noir focus:outline-none focus:border-noir placeholder:text-noir/30"
                />
              </div>
              <button
                type="submit"
                class="h-10 px-6 bg-noir text-cotton font-inter text-sm font-medium hover:bg-maroon transition-colors"
              >
                Confirm Dispatch
              </button>
            </form>
          )}

          {order.status === "dispatched" && (
            <div class="mt-4 pt-4 border-t border-noir/10 font-inter text-sm text-noir/60">
              <p class="font-semibold text-lime">Dispatched</p>
              {order.dispatched_at && <p class="text-xs mt-0.5">{new Date(order.dispatched_at).toLocaleString("en-NG", { dateStyle: "medium", timeStyle: "short" })}</p>}
              {order.tracking_number && <p class="mt-1">Tracking: <strong class="text-noir font-mono">{order.tracking_number}</strong></p>}
            </div>
          )}
        </div>
      )}

      <!-- Meta -->
      <div class="font-inter text-xs text-noir/30 space-y-0.5">
        <p>Created: {new Date(order.created_at).toLocaleString("en-NG", { dateStyle: "long", timeStyle: "short" })}</p>
        <p>Updated: {new Date(order.updated_at).toLocaleString("en-NG", { dateStyle: "long", timeStyle: "short" })}</p>
      </div>

    </main>
  </div>
</Layout>
