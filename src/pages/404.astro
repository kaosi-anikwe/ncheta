---
import Layout from "../layouts/Layout.astro";
import Header from "../components/navigation/Header.astro";
import Footer from "../components/navigation/Footer.astro";
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <Header />

  <main class="flex-1 flex items-center justify-center px-4 py-24">
    <div class="max-w-md text-center">
      <p class="font-cinzel text-6xl font-bold text-noir/10 mb-6 tracking-widest">404</p>
      <h1 class="font-cinzel text-2xl font-bold text-noir mb-4">Page Not Found</h1>
      <p class="font-inter text-sm text-noir/60 leading-relaxed mb-8">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/"
          class="h-11 px-6 bg-noir text-cotton font-inter text-sm font-medium hover:bg-maroon transition-colors inline-flex items-center justify-center"
        >
          Go to Homepage
        </a>
        <a
          href="/store"
          class="h-11 px-6 border border-noir/20 text-noir font-inter text-sm hover:border-noir transition-colors inline-flex items-center justify-center"
        >
          Visit the Store
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
