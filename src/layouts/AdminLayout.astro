---
import Layout from "./Layout.astro";

export interface Props {
  title: string;
  activePage?: "orders" | "inventory" | "upload";
}

const { title, activePage } = Astro.props;

const navItems = [
  { key: "orders",    href: "/admin/orders",    label: "Orders" },
  { key: "inventory", href: "/admin/inventory", label: "Inventory" },
  { key: "upload",    href: "/admin/upload",    label: "Upload" },
] as const;
---

<Layout title={`${title} — Admin`} description="Ncheta admin panel">
  <div class="min-h-screen bg-cotton flex flex-col">

    <!-- Header — mirrors main Header structure -->
    <header class="sticky top-0 z-50 bg-cotton border-b border-noir/10" role="banner">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 md:h-20 gap-4">

          <!-- Logo -->
          <a
            href="/admin/orders"
            class="shrink-0 flex items-center gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-maroon/60"
            aria-label="Ncheta Admin"
          >
            <img src="/logo.svg" alt="Ncheta Magazine" class="h-8 md:h-10 w-auto" />
            <span class="font-inter text-[10px] font-semibold uppercase tracking-widest text-noir/40 border border-noir/20 px-1.5 py-0.5 leading-none">
              Admin
            </span>
          </a>

          <!-- Desktop nav + sign out -->
          <div class="hidden lg:flex items-center gap-1">
            {navItems.map(({ key, href, label }) => (
              <a
                href={href}
                class:list={[
                  "px-3 py-1.5 font-inter text-sm transition-colors",
                  activePage === key
                    ? "text-noir font-semibold"
                    : "text-noir/50 hover:text-noir",
                ]}
              >
                {label}
              </a>
            ))}
            <span class="w-px h-4 bg-noir/15 mx-2"></span>
            <form method="POST" action="/api/admin/logout">
              <button class="px-3 py-1.5 font-inter text-sm text-noir/40 hover:text-noir transition-colors">
                Sign out
              </button>
            </form>
          </div>

          <!-- Mobile hamburger (details/summary — no JS needed) -->
          <details class="lg:hidden group relative">
            <summary
              class="list-none cursor-pointer p-1.5 text-noir/60 hover:text-noir transition-colors"
              aria-label="Toggle admin menu"
            >
              <!-- Hamburger icon -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 group-open:hidden"
                fill="none" viewBox="0 0 24 24"
                stroke="currentColor" stroke-width="1.75"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <!-- Close icon -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 hidden group-open:block"
                fill="none" viewBox="0 0 24 24"
                stroke="currentColor" stroke-width="1.75"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </summary>

            <!-- Mobile dropdown -->
            <div class="absolute right-0 top-full mt-1 w-48 bg-cotton border border-noir/10 shadow-lg z-50 py-1">
              {navItems.map(({ key, href, label }) => (
                <a
                  href={href}
                  class:list={[
                    "block px-4 py-2.5 font-inter text-sm transition-colors",
                    activePage === key
                      ? "text-noir font-semibold bg-noir/5"
                      : "text-noir/60 hover:text-noir hover:bg-noir/5",
                  ]}
                >
                  {label}
                </a>
              ))}
              <div class="border-t border-noir/10 mt-1 pt-1">
                <form method="POST" action="/api/admin/logout">
                  <button class="w-full text-left block px-4 py-2.5 font-inter text-sm text-noir/40 hover:text-noir hover:bg-noir/5 transition-colors">
                    Sign out
                  </button>
                </form>
              </div>
            </div>
          </details>

        </div>
      </div>
    </header>

    <!-- Page content -->
    <main class="flex-1">
      <slot />
    </main>

  </div>
</Layout>
